#!/usr/bin/env python3
"""Stub cm-api-token-stats: prints non-zero token totals.

Mirrors the upstream flag surface: fork-only flags exit 2 like argparse.
When --since is provided, returns per-session token totals (42). When it is
omitted, simulates cumulative state.db token accumulation
across multiple calls in the same environment. Echoes argv and $CM_HOME;
CM_STUB_TS_SLEEP delays the output.
"""
import json, os, pathlib, sys, time

FORK_FLAGS = ("--since-time", "--discover-logs", "--log-dir")
if any(a in FORK_FLAGS for a in sys.argv[1:]):
  sys.exit(2)
time.sleep(float(os.environ.get("CM_STUB_TS_SLEEP", "0")))

home = pathlib.Path(os.environ.get("HOME", "/tmp")) / ".codemender"
has_since = "--since" in sys.argv

if has_since:
  total = 42
else:
  # Simulate cumulative sessions when --since-time is omitted.
  counter_file = home / "stub_sessions_count"
  count = 0
  if counter_file.exists():
    try:
      count = int(counter_file.read_text().strip())
    except ValueError:
      count = 0
  count += 1
  try:
    home.mkdir(parents=True, exist_ok=True)
    counter_file.write_text(str(count))
  except OSError:
    pass
  total = 42 * count

print(json.dumps({"input_tokens": 30, "output_tokens": 10, "cached_tokens": 0,
                  "thought_tokens": 2, "tool_calls": 3, "total_tokens": total,
                  "total_turns": 4, "argv": sys.argv[1:],
                  "cm_home": os.environ.get("CM_HOME")}))

