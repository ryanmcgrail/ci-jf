#!/usr/bin/env python3
"""Stub curl: GCS JSON uploads hit $GCS_EMU (create-only); googleapis answers
404; everything else is unreachable."""
import os, pathlib, shutil, sys, urllib.parse
a = sys.argv[1:]
for u in a:
  if u.startswith("https://storage.googleapis.com/upload/storage/v1/b/"):
    bucket = u.split("/b/", 1)[1].split("/", 1)[0]
    q = urllib.parse.parse_qs(urllib.parse.urlparse(u).query)
    src = next(x[1:] for x in a if x.startswith("@"))
    deny = set(filter(None, os.environ.get("GCS_DENY_WRITE", "").split(",")))
    if bucket in deny:
      sys.stderr.write("curl: (22) The requested URL returned error: 403\n"); sys.exit(22)
    target = pathlib.Path(os.environ["GCS_EMU"]) / bucket / q["name"][0]
    if target.exists():
      sys.stderr.write("curl: (22) The requested URL returned error: 412\n"); sys.exit(22)
    target.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(src, target)
    sys.exit(0)
for u in a:
  if u.startswith("https://") and ".googleapis.com" in u.split("/")[2]:
    sys.stdout.write("404"); sys.exit(0)
  if u.startswith("https://"):
    sys.stderr.write("curl: (28) Connection timed out\n"); sys.exit(28)
sys.exit(2)
